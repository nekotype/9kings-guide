---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories, categoryLabel, formatDate, withBase } from '../../lib/site';
export async function getStaticPaths() {
  return (await getCollection('articles')).map(entry => {
    const [category, ...parts] = entry.id.split('/');
    return { params: { category, slug: parts.join('/') }, props: { entry } };
  });
}
interface Props { entry: CollectionEntry<'articles'> }
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---
<BaseLayout title={data.title} description={data.description} article date={data.date}>
  <p class="breadcrumb"><a href={withBase('')}>トップ</a> / <a href={withBase(`${data.category}/`)}>{categories[data.category].label}</a></p>
  <article class="article">
    <header>
      <p class="eyebrow">{categoryLabel(data.category)}</p>
      <h1>{data.title}</h1>
      <p class="lead">{data.description}</p>
      <dl class="metadata">
        <div><dt>カテゴリ</dt><dd>{categoryLabel(data.category)}</dd></div>
        <div><dt>王</dt><dd>{data.king}</dd></div>
        <div><dt>投稿日</dt><dd><time datetime={data.date.toISOString()}>{formatDate(data.date)}</time></dd></div>
        {data.version && <div><dt>ゲームバージョン</dt><dd>{data.version}</dd></div>}
      </dl>
      <ul class="tags" aria-label="タグ">{data.tags.map(tag => <li>{tag}</li>)}</ul>
    </header>
    {data.category === 'cards' && <section class="card-details panel" aria-labelledby="card-info">
      <h2 id="card-info">カード基本情報</h2>
      <dl class="metadata">
        <div><dt>日本語名</dt><dd>{data.japaneseName}</dd></div>
        <div><dt>英語名</dt><dd lang="en">{data.englishName}</dd></div>
        <div><dt>カード種類</dt><dd>{data.cardType || '未確認'}</dd></div>
      </dl>
    </section>}
    {data.cover && <Image src={data.cover} alt={data.coverAlt!} />}
    <div class="prose"><Content /></div>
    <p class="back-link"><a href={withBase(`${data.category}/`)}>← {categories[data.category].label}へ戻る</a></p>
  </article>
</BaseLayout>
